# ── ShieldEye Environment Configuration ──────────────────────────────────────
#
# VIDEO_SOURCE options:
#   - Path to a local video file:    VIDEO_SOURCE=test.mp4
#   - Webcam by index:               VIDEO_SOURCE=0
#   - RTSP live stream (IP camera):  VIDEO_SOURCE=rtsp://admin:password@192.168.1.100:554/stream
#   - HTTP stream:                   VIDEO_SOURCE=http://192.168.1.100:8080/video
#
# For local testing, place your video file in the project root as test.mp4
# and either set this to the filename or leave it blank (auto-detected).

VIDEO_SOURCE=test.mp4

# ── Live RTSP Feed (uncomment when deploying with a real IP camera) ──────────
# VIDEO_SOURCE=rtsp://admin:yourpassword@192.168.1.100:554/h264/ch1/main/av_stream
